PORT=8787

# MariaDB / MySQL (ex.: mysql://user:pass@host:port/database)
DATABASE_URL=mysql://user:password@localhost:3306/acaf

# JWT para sessões do painel admin
JWT_SECRET=change-me-in-production

# Usuário admin inicial (criado automaticamente se a tabela estiver vazia)
ADMIN_EMAIL=admin@acaf.com.br
ADMIN_PASSWORD=change-me

# Sincronizar schema TypeORM (true em dev, false em produção)
DB_SYNC=true

# SSL obrigatório no MariaDB remoto (require_secure_transport)
DATABASE_SSL=true

# Busca CEP (https://cep.hub.tagsa.com.br)
BUSCA_CEP_KEY=change-me

# App mobile (instruções no e-mail de código de adesão)
CONNECT_APP_URL=

# Portal corporativo (opcional — gestão RH)
CORPORATE_APP_URL=http://127.0.0.1:5177

# SMTP — necessário para "E-mail" no portal corporativo
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@acaf.com.br

# Nextcloud (WebDAV + link público para logos)
NEXTCLOUD_URL=http://nextcloud-yko4cso4kwgcckg4c4gco0cg.76.13.66.204.sslip.io
NEXTCLOUD_USERNAME=admin
NEXTCLOUD_PASSWORD=change-me
NEXTCLOUD_ROOT_FOLDER=acaf

# Redes/unidades/check-ins persistem em MariaDB (tabela acaf_partner_store).
# Seed demo corporativo — não usar em produção.
# ACAF_SEED_DEMO=true
