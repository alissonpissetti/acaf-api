PORT=8787

# MariaDB / MySQL (ex.: mysql://user:pass@host:port/database)
DATABASE_URL=mysql://user:password@localhost:3306/acaf

# JWT para sessões do painel admin
JWT_SECRET=change-me-in-production

# Usuário admin inicial (criado automaticamente se a tabela estiver vazia)
ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_PASSWORD=change-me

# Sincronizar schema TypeORM (true em dev, false em produção)
DB_SYNC=true

# SSL obrigatório no MariaDB remoto (require_secure_transport)
DATABASE_SSL=true

# Busca CEP (https://cep.hub.tagsa.com.br)
BUSCA_CEP_KEY=change-me

# App mobile (botão no convite por e-mail ao colaborador)
CONNECT_APP_URL=

# Logo oficial no e-mail: a API publica assets/branding/movly-logo-lime-on-purple.png
# no Nextcloud (pasta {NEXTCLOUD_ROOT_FOLDER}/branding) e usa o link público.
# MAIL_LOGO_URL=https://storage.seudominio.com/s/xxxx/download  # opcional; se vazio, publica sozinha
# BRAND_ASSETS_PUBLIC_URL=https://corporate.seudominio.com.br   # fallback se o storage falhar
# Base HTTPS com os .woff2 (ex.: site ou CDN). Se vazio, a API publica Figtree em {NEXTCLOUD_ROOT_FOLDER}/branding/fonts.
# BRAND_FONTS_PUBLIC_BASE_URL=https://corporate.seudominio.com.br/fonts

# Portal corporativo (opcional — gestão RH)
CORPORATE_APP_URL=http://127.0.0.1:5177

# URL pública do portal parceiro — usada nos links de onboarding gerados no admin
# Em produção, omita ou use https://parceiro.sejamovly.com (padrão da API sem esta variável)
# PARTNER_PORTAL_PUBLIC_URL=https://parceiro.sejamovly.com
PARTNER_PORTAL_PUBLIC_URL=http://127.0.0.1:5176

# URL pública da API (fallback se não estiver em Sistema → Configurações → apiPublicBaseUrl)
# API_PUBLIC_URL=https://api.seudominio.com.br

# Formulário de contato do site → funil marcado como «Funil padrão para novos leads» no admin (sem env de funil)
# SITE_LEAD_OWNER_USER_ID=                         # opcional; padrão = primeiro admin ativo
# SITE_LEAD_SECRET=                                # opcional; exige header x-site-lead-secret

# Segredo opcional no header x-evolution-webhook-secret do webhook inbound
# EVOLUTION_WEBHOOK_SECRET=

# E-mail (convites corporate, etc.) — escolha SMTP ou Hostinger Mail API
# MAIL_PROVIDER=hostinger
# MAIL_PROVIDER=smtp

# Hostinger Mail API (token em Agentic Mail → API access no domínio de e-mail)
# https://docs.hostinger.com/emails/mail-api
# HOSTINGER_MAIL_API_TOKEN=
# HOSTINGER_MAIL_FROM=tecnologia@sejamovly.com.br
# HOSTINGER_MAIL_DISPLAY_NAME=Movly
# HOSTINGER_MAIL_MAILBOX_ID=   # opcional; se vazio, resolve via GET /api/v1/me

# SMTP (alternativa; não use junto com token Hostinger se MAIL_PROVIDER não estiver definido)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tecnologia@sejamovly.com.br
# SMTP_PASS=                        # senha da caixa de e-mail, NÃO é o token da Mail API
# SMTP_FROM="Movly <tecnologia@sejamovly.com.br>"

# SMS transacional (Comtele — mesmo contrato da api-formo-v2)
# SMS_PROVIDER=comtele
# COMTELE_URL=https://sms.comtele.com.br
# COMTELE_AUTH_KEY=
# COMTELE_SENDER=Movly

# Nextcloud (WebDAV + link público para logos)
NEXTCLOUD_URL=http://nextcloud-yko4cso4kwgcckg4c4gco0cg.76.13.66.204.sslip.io
NEXTCLOUD_USERNAME=admin
NEXTCLOUD_PASSWORD=change-me
NEXTCLOUD_ROOT_FOLDER=acaf

# Redes/unidades/check-ins persistem em MariaDB (tabela acaf_partner_store).
# Seed demo corporativo — não usar em produção.
# CONNECT_SEED_DEMO=true
